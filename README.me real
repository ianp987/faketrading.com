1<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>HustleTrack — Income & Invoice Manager</title>
<style>
  :root{
    --bg:#0b0f16; --panel:#121826; --panel-2:#182030; --line:#243044;
    --txt:#e8eef7; --muted:#8c9bb1; --green:#22c55e; --blue:#3b82f6;
    --amber:#f59e0b; --red:#ef4444; --r:14px;
  }
  *{box-sizing:border-box}
  body{
    margin:0; color:var(--txt); min-height:100vh;
    font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,Inter,sans-serif;
    background:
      radial-gradient(900px 500px at 85% -15%, rgba(59,130,246,.22), transparent 60%),
      radial-gradient(700px 400px at 5% 0%, rgba(34,197,94,.13), transparent 60%),
      var(--bg);
  }
  .wrap{max-width:1080px;margin:0 auto;padding:22px 18px 60px}

  /* ---------- Top bar ---------- */
  .topbar{display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between;margin-bottom:18px}
  .brand{display:flex;gap:12px;align-items:center}
  .logo{
    width:44px;height:44px;border-radius:13px;display:grid;place-items:center;
    font-size:22px;font-weight:800;color:#04220f;
    background:linear-gradient(135deg,#4ade80,#22c55e 60%,#16a34a);
    box-shadow:0 8px 22px rgba(34,197,94,.35);
  }
  .brand h1{margin:0;font-size:19px;letter-spacing:-.3px}
  .brand p{margin:2px 0 0;font-size:12.5px;color:var(--muted)}
  .actions{display:flex;gap:9px;flex-wrap:wrap}

  /* ---------- Buttons ---------- */
  .btn{
    border:1px solid var(--line); background:var(--panel-2); color:var(--txt);
    padding:9px 15px; border-radius:11px; font-size:13.5px; font-weight:600;
    cursor:pointer; transition:.15s; font-family:inherit;
  }
  .btn:hover{background:#202a3c; transform:translateY(-1px)}
  .btn.primary{
    background:linear-gradient(135deg,#4ade80,#22c55e); color:#04220f; border-color:transparent;
    box-shadow:0 6px 18px rgba(34,197,94,.3);
  }
  .btn.primary:hover{filter:brightness(1.07)}
  .btn.mini{padding:5px 10px;font-size:12px;border-radius:9px}
  .btn.danger{color:#ffb4b4;border-color:#4a2530;background:#2a1620}
  .btn.danger:hover{background:#3a1c28}

  /* ---------- Tabs ---------- */
  .tabs{display:flex;gap:6px;background:var(--panel);border:1px solid var(--line);
        padding:6px;border-radius:13px;margin-bottom:20px;overflow-x:auto}
  .tab{
    flex:0 0 auto;border:0;background:transparent;color:var(--muted);
    padding:9px 16px;border-radius:9px;font-size:13.5px;font-weight:600;
    cursor:pointer;font-family:inherit;transition:.15s;white-space:nowrap;
  }
  .tab:hover{color:var(--txt)}
  .tab.active{background:var(--panel-2);color:var(--txt);box-shadow:0 2px 10px rgba(0,0,0,.35)}

  /* ---------- Cards ---------- */
  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:13px;margin-bottom:20px}
  .card{
    background:linear-gradient(180deg,var(--panel-2),var(--panel));
    border:1px solid var(--line); border-radius:var(--r); padding:16px 17px;
  }
  .card .label{font-size:11.5px;text-transform:uppercase;letter-spacing:.09em;color:var(--muted);font-weight:700}
  .card .value{font-size:25px;font-weight:800;margin-top:7px;letter-spacing:-.7px}
  .card .sub{font-size:12px;color:var(--muted);margin-top:4px}
  .v-green{color:var(--green)} .v-blue{color:#7fb0ff} .v-amber{color:var(--amber)} .v-red{color:#ff8b8b}

  /* ---------- Panels ---------- */
  .panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:18px;margin-bottom:18px}
  .panel h2{margin:0 0 14px;font-size:14.5px;letter-spacing:.2px}
  .panel h2 span{color:var(--muted);font-weight:500;font-size:12.5px}

  /* ---------- Chart ---------- */
  .chart{display:flex;align-items:flex-end;gap:10px;height:170px;padding-top:8px}
  .col{flex:1;display:flex;flex-direction:column;align-items:center;gap:7px;height:100%}
  .bar{width:100%;flex:1;display:flex;align-items:flex-end;background:rgba(255,255,255,.03);border-radius:8px;overflow:hidden}
  .fill{
    width:100%;border-radius:8px 8px 0 0;
    background:linear-gradient(180deg,#4ade80,#16a34a);
    min-height:3px;transition:height .45s cubic-bezier(.4,0,.2,1);
  }
  .col .cap{font-size:11px;color:var(--muted);font-weight:600}
  .col .amt{font-size:10.5px;color:#5f6d82}

  /* ---------- Tables ---------- */
  .tbl-wrap{overflow-x:auto;margin:0 -18px;padding:0 18px}
  table{width:100%;border-collapse:collapse;font-size:13.5px;min-width:620px}
  th{
    text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.08em;
    color:var(--muted);padding:0 10px 10px;font-weight:700;border-bottom:1px solid var(--line);
  }
  td{padding:12px 10px;border-bottom:1px solid rgba(36,48,68,.6);vertical-align:middle}
  tbody tr:hover{background:rgba(255,255,255,.018)}
  td.amt{font-weight:700;white-space:nowrap}
  .who{font-weight:600}
  .small{font-size:12px;color:var(--muted)}

  /* ---------- Pills ---------- */
  .pill{display:inline-block;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:700;letter-spacing:.02em}
  .pill.paid{background:rgba(34,197,94,.16);color:#5ee98b}
  .pill.pending{background:rgba(245,158,11,.16);color:#fbbf24}
  .pill.overdue{background:rgba(239,68,68,.16);color:#ff8b8b}

  /* ---------- Filters ---------- */
  .filters{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:14px}
  .chip{
    border:1px solid var(--line);background:transparent;color:var(--muted);
    padding:6px 13px;border-radius:999px;font-size:12.5px;font-weight:600;
    cursor:pointer;font-family:inherit;transition:.15s;
  }
  .chip:hover{color:var(--txt)}
  .chip.active{background:var(--panel-2);color:var(--txt);border-color:#33415a}

  /* ---------- Empty state ---------- */
  .empty{text-align:center;padding:34px 14px;color:var(--muted)}
  .empty .big{font-size:34px;margin-bottom:8px;opacity:.55}
  .empty p{margin:0 0 14px;font-size:13.5px}

  /* ---------- Dialog ---------- */
  dialog{
    border:1px solid var(--line);background:var(--panel);color:var(--txt);
    border-radius:18px;padding:0;width:min(460px,92vw);
    box-shadow:0 30px 80px rgba(0,0,0,.6);
  }
  dialog::backdrop{background:rgba(3,6,12,.72);backdrop-filter:blur(4px)}
  .dlg-head{padding:18px 20px 0}
  .dlg-head h3{margin:0;font-size:16px}
  .dlg-head p{margin:5px 0 0;font-size:12.5px;color:var(--muted)}
  .dlg-body{padding:16px 20px;display:grid;gap:12px}
  .dlg-foot{padding:0 20px 18px;display:flex;gap:9px;justify-content:flex-end}
  label.fld{display:grid;gap:6px;font-size:12.5px;font-weight:600;color:#b8c4d6}
  input,select{
    background:#0d1320;border:1px solid var(--line);color:var(--txt);
    padding:10px 12px;border-radius:10px;font-size:14px;font-family:inherit;width:100%;
  }
  input:focus,select:focus{outline:none;border-color:#3b82f6;box-shadow:0 0 0 3px rgba(59,130,246,.18)}
  .row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .check{display:flex;align-items:center;gap:9px;font-size:13.5px;color:#b8c4d6;font-weight:600}
  .check input{width:17px;height:17px;accent-color:var(--green)}

  footer{text-align:center;font-size:12px;color:#5f6d82;margin-top:26px;line-height:1.7}
  @media(max-width:560px){
    .actions{width:100%}
    .actions .btn{flex:1}
    .row2{grid-template-columns:1fr}
  }
</style>
</head>
<body>
<div class="wrap">

  <!-- ══════════ TOP BAR ══════════ -->
  <div class="topbar">
    <div class="brand">
      <div class="logo">$</div>
      <div>
        <h1>HustleTrack</h1>
        <p>Track your income, invoices &amp; clients</p>
      </div>
    </div>
    <div class="actions">
      <button class="btn" id="exportBtn">⬇ Export CSV</button>
      <button class="btn primary" id="newInvoiceBtn">+ New Invoice</button>
    </div>
  </div>

  <!-- ══════════ TABS ══════════ -->
  <div class="tabs">
    <button class="tab active" data-tab="dashboard">Dashboard</button>
    <button class="tab" data-tab="invoices">Invoices</button>
    <button class="tab" data-tab="clients">Clients</button>
    <button class="tab" data-tab="settings">Settings</button>
  </div>

  <!-- ══════════ DASHBOARD ══════════ -->
  <section id="tab-dashboard">
    <div class="grid" id="statCards"></div>

    <div class="panel">
      <h2>Income — last 6 months <span>(paid invoices)</span></h2>
      <div class="chart" id="chart"></div>
    </div>

    <div class="panel">
      <h2>Needs attention <span>(unpaid &amp; overdue)</span></h2>
      <div id="attention"></div>
    </div>
  </section>

  <!-- ══════════ INVOICES ══════════ -->
  <section id="tab-invoices" hidden>
    <div class="panel">
      <h2>All invoices</h2>
      <div class="filters" id="filters">
        <button class="chip active" data-filter="all">All</button>
        <button class="chip" data-filter="pending">Pending</button>
        <button class="chip" data-filter="overdue">Overdue</button>
        <button class="chip" data-filter="paid">Paid</button>
      </div>
      <div id="invoiceTable"></div>
    </div>
  </section>

  <!-- ══════════ CLIENTS ══════════ -->
  <section id="tab-clients" hidden>
    <div class="panel">
      <h2>Add a client</h2>
      <form id="clientForm" style="display:grid;gap:12px;grid-template-columns:1fr 1fr auto" class="client-form">
        <input id="cName" placeholder="Client name" required />
        <input id="cEmail" type="email" placeholder="Email (optional)" />
        <button class="btn primary" type="submit">Add</button>
      </form>
    </div>
    <div class="panel">
      <h2>Your clients</h2>
      <div id="clientList"></div>
    </div>
  </section>

  <!-- ══════════ SETTINGS ══════════ -->
  <section id="tab-settings" hidden>
    <div class="panel">
      <h2>Business details <span>(used on printed invoices)</span></h2>
      <div style="display:grid;gap:12px">
        <label class="fld">Business / your name
          <input id="sBizName" placeholder="Jane Doe Studio" />
        </label>
        <label class="fld">Contact email
          <input id="sBizEmail" placeholder="you@example.com" />
        </label>
        <label class="fld">Currency
          <select id="sCurrency">
            <option value="USD">USD — US Dollar</option>
            <option value="EUR">EUR — Euro</option>
            <option value="GBP">GBP — British Pound</option>
            <option value="NGN">NGN — Nigerian Naira</option>
            <option value="INR">INR — Indian Rupee</option>
            <option value="CAD">CAD — Canadian Dollar</option>
            <option value="AUD">AUD — Australian Dollar</option>
            <option value="ZAR">ZAR — South African Rand</option>
            <option value="KES">KES — Kenyan Shilling</option>
            <option value="BRL">BRL — Brazilian Real</option>
          </select>
        </label>
      </div>
    </div>
    <div class="panel">
      <h2>Data</h2>
      <p class="small" style="margin:0 0 12px">Everything is stored in this browser only. Clearing site data deletes it — export a CSV backup first.</p>
      <div style="display:flex;gap:9px;flex-wrap:wrap">
        <button class="btn" id="demoBtn">Load demo data</button>
        <button class="btn danger" id="clearBtn">Delete all data</button>
      </div>
    </div>
  </section>

  <footer>
    HustleTrack · your data never leaves this device<br />
    Built with plain HTML, CSS &amp; JavaScript
  </footer>
</div>

<!-- ══════════ INVOICE DIALOG ══════════ -->
<dialog id="invoiceDialog">
  <form method="dialog" id="invoiceForm">
    <div class="dlg-head">
      <h3>New invoice</h3>
      <p>Record a job you've done or are about to do.</p>
    </div>
    <div class="dlg-body">
      <label class="fld">Client
        <input id="fClient" list="clientOptions" placeholder="Type a name…" required autocomplete="off" />
        <datalist id="clientOptions"></datalist>
      </label>
      <label class="fld">Description
        <input id="fDesc" placeholder="Logo design, article, consulting…" required />
      </label>
      <div class="row2">
        <label class="fld">Amount
          <input id="fAmount" type="number" min="0" step="0.01" placeholder="0.00" required />
        </label>
        <label class="fld">Issued on
          <input id="fIssue" type="date" required />
        </label>
      </div>
      <label class="fld">Due date
        <input id="fDue" type="date" required />
      </label>
      <label class="check">
        <input type="checkbox" id="fPaid" /> Already paid
      </label>
    </div>
    <div class="dlg-foot">
      <button type="button" class="btn" id="cancelBtn">Cancel</button>
      <button type="submit" class="btn primary">Save invoice</button>
    </div>
  </form>
</dialog>

<script>
/* ═══════════════════════════════════════════
   STATE
   ═══════════════════════════════════════════ */
const KEY = 'hustletrack.v1';

let state = {
  business: { name: '', email: '' },
  currency: 'USD',
  clients: [],
  invoices: []
};

const $  = (s, el = document) => el.querySelector(s);
const $$ = (s, el = document) => [...el.querySelectorAll(s)];
const uid = () => Math.random().toString(36).slice(2, 9);
const esc = s => String(s ?? '').replace(/[&<>"']/g,
  c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));

const ymOf = d => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
const todayISO = () => {
  const d = new Date();
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
};
const addDays = (iso, n) => {
  const d = new Date(iso + 'T00:00:00');
  d.setDate(d.getDate() + n);
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
};
const money = n => new Intl.NumberFormat(undefined, {
  style: 'currency', currency: state.currency, maximumFractionDigits: 2
}).format(Number(n) || 0);

/* ═══════════════════════════════════════════
   PERSISTENCE
   ═══════════════════════════════════════════ */
function save() {
  try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {}
}
function load() {
  try {
    const raw = localStorage.getItem(KEY);
    if (raw) state = Object.assign(state, JSON.parse(raw));
  } catch (e) {}
}

/* ═══════════════════════════════════════════
   HELPERS
   ═══════════════════════════════════════════ */
function invoiceStatus(inv) {
  if (inv.paid) return 'paid';
  if (inv.dueDate && inv.dueDate < todayISO()) return 'overdue';
  return 'pending';
}
const clientName = id => (state.clients.find(c => c.id === id) || {}).name || 'Unknown';
const clientEmail = id => (state.clients.find(c => c.id === id) || {}).email || '';

function stats() {
  const inv = state.invoices;
  const paid = inv.filter(i => i.paid);
  const unpaid = inv.filter(i => !i.paid);
  const month = ymOf(new Date());
  return {
    earned: paid.reduce((s, i) => s + (+i.amount || 0), 0),
    outstanding: unpaid.reduce((s, i) => s + (+i.amount || 0), 0),
    overdue: unpaid.filter(i => invoiceStatus(i) === 'overdue')
                   .reduce((s, i) => s + (+i.amount || 0), 0),
    thisMonth: paid.filter(i => (i.paidDate || i.issueDate || '').startsWith(month))
                   .reduce((s, i) => s + (+i.amount || 0), 0),
    clientCount: state.clients.length
  };
}

/* ═══════════════════════════════════════════
   RENDER — DASHBOARD
   ═══════════════════════════════════════════ */
function renderDashboard() {
  const s = stats();

  $('#statCards').innerHTML = `
    <div class="card">
      <div class="label">Total earned</div>
      <div class="value v-green">${money(s.earned)}</div>
      <div class="sub">${state.invoices.filter(i => i.paid).length} paid invoice(s)</div>
    </div>
    <div class="card">
      <div class="label">Outstanding</div>
      <div class="value v-amber">${money(s.outstanding)}</div>
      <div class="sub">${s.overdue > 0 ? `<span class="v-red">${money(s.overdue)} overdue</span>` : 'Nothing overdue 🎉'}</div>
    </div>
    <div class="card">
      <div class="label">This month</div>
      <div class="value v-blue">${money(s.thisMonth)}</div>
      <div class="sub">${new Date().toLocaleString(undefined, { month: 'long', year: 'numeric' })}</div>
    </div>
    <div class="card">
      <div class="label">Clients</div>
      <div class="value">${s.clientCount}</div>
      <div class="sub">${state.invoices.length} invoice(s) total</div>
    </div>`;

  // ---- 6-month chart ----
  const months = [];
  const now = new Date();
  for (let i = 5; i >= 0; i--) {
    const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
    const key = ymOf(d);
    const total = state.invoices
      .filter(x => x.paid && (x.paidDate || x.issueDate || '').startsWith(key))
      .reduce((sum, x) => sum + (+x.amount || 0), 0);
    months.push({ label: d.toLocaleString(undefined, { month: 'short' }), total });
  }
  const max = Math.max(...months.map(m => m.total), 1);
  $('#chart').innerHTML = months.map(m => `
    <div class="col">
      <div class="amt">${m.total ? money(m.total) : ''}</div>
      <div class="bar"><div class="fill" style="height:${m.total ? Math.max(4, (m.total / max) * 100) : 2}%"></div></div>
      <div class="cap">${m.label}</div>
    </div>`).join('');

  // ---- Needs attention ----
  const pending = state.invoices
    .filter(i => !i.paid)
    .sort((a, b) => (a.dueDate || '').localeCompare(b.dueDate || ''));

  $('#attention').innerHTML = pending.length ? `
    <div class="tbl-wrap">
      <table>
        <thead><tr><th>Client</th><th>Job</th><th>Due</th><th>Amount</th><th>Status</th><th></th></tr></thead>
        <tbody>
          ${pending.slice(0, 6).map(i => {
            const st = invoiceStatus(i);
            return `<tr>
              <td class="who">${esc(clientName(i.clientId))}</td>
              <td class="small">${esc(i.desc)}</td>
              <td class="small">${esc(i.dueDate || '—')}</td>
              <td class="amt">${money(i.amount)}</td>
              <td><span class="pill ${st}">${st}</span></td>
              <td><button class="btn mini primary" data-pay="${i.id}">Mark paid</button></td>
            </tr>`;
          }).join('')}
        </tbody>
      </table>
    </div>` : `<div class="empty"><div class="big">✓</div><p>All caught up — no unpaid invoices.</p></div>`;
}

/* ═══════════════════════════════════════════
   RENDER — INVOICES
   ═══════════════════════════════════════════ */
let currentFilter = 'all';

function renderInvoices() {
  let list = [...state.invoices].sort((a, b) =>
    (b.issueDate || '').localeCompare(a.issueDate || ''));
  if (currentFilter !== 'all') list = list.filter(i => invoiceStatus(i) === currentFilter);

  if (!list.length) {
    $('#invoiceTable').innerHTML = `
      <div class="empty">
        <div class="big">🧾</div>
        <p>No invoices here yet.</p>
        <button class="btn primary" onclick="openInvoice()">+ Create your first invoice</button>
      </div>`;
    return;
  }

  $('#invoiceTable').innerHTML = `
    <div class="tbl-wrap">
      <table>
        <thead>
          <tr><th>Client</th><th>Job</th><th>Issued</th><th>Due</th><th>Amount</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
          ${list.map(i => {
            const st = invoiceStatus(i);
            return `<tr>
              <td class="who">${esc(clientName(i.clientId))}</td>
              <td class="small">${esc(i.desc)}</td>
              <td class="small">${esc(i.issueDate || '—')}</td>
              <td class="small">${esc(i.dueDate || '—')}</td>
              <td class="amt">${money(i.amount)}</td>
              <td><span class="pill ${st}">${st}</span></td>
              <td style="white-space:nowrap;text-align:right">
                <button class="btn mini" data-print="${i.id}">Print</button>
                <button class="btn mini ${i.paid ? '' : 'primary'}" data-pay="${i.id}">${i.paid ? 'Undo' : 'Paid'}</button>
                <button class="btn mini danger" data-del="${i.id}">✕</button>
              </td>
            </tr>`;
          }).join('')}
        </tbody>
      </table>
    </div>`;
}

/* ═══════════════════════════════════════════
   RENDER — CLIENTS
   ═══════════════════════════════════════════ */
function renderClients() {
  const datalist = state.clients.map(c => `<option value="${esc(c.name)}">`).join('');
  $('#clientOptions').innerHTML = datalist;

  if (!state.clients.length) {
    $('#clientList').innerHTML = `
      <div class="empty"><div class="big">👥</div><p>No clients yet — add one above.</p></div>`;
    return;
  }

  $('#clientList').innerHTML = `
    <div class="tbl-wrap">
      <table>
        <thead><tr><th>Name</th><th>Email</th><th>Invoices</th><th>Billed</th><th>Outstanding</th><th></th></tr></thead>
        <tbody>
          ${state.clients.map(c => {
            const inv = state.invoices.filter(i => i.clientId === c.id);
            const billed = inv.reduce((s, i) => s + (+i.amount || 0), 0);
            const out = inv.filter(i => !i.paid).reduce((s, i) => s + (+i.amount || 0), 0);
            return `<tr>
              <td class="who">${esc(c.name)}</td>
              <td class="small">${esc(c.email || '—')}</td>
              <td>${inv.length}</td>
              <td class="amt">${money(billed)}</td>
              <td class="amt">${out ? `<span class="v-amber">${money(out)}</span>` : '—'}</td>
              <td style="text-align:right"><button class="btn mini danger" data-delclient="${c.id}">✕</button></td>
            </tr>`;
          }).join('')}
        </tbody>
      </table>
    </div>`;
}

/* ═══════════════════════════════════════════
   MASTER RENDER
   ═══════════════════════════════════════════ */
function renderAll() {
  renderDashboard();
  renderInvoices();
  renderClients();
  save();
}

/* ═══════════════════════════════════════════
   INVOICE DIALOG
   ═══════════════════════════════════════════ */
const dlg = $('#invoiceDialog');

function openInvoice() {
  const t = todayISO();
  $('#invoiceForm').reset();
  $('#fIssue').value = t;
  $('#fDue').value = addDays(t, 14);
  dlg.showModal();
  setTimeout(() => $('#fClient').focus(), 50);
}

$('#newInvoiceBtn').addEventListener('click', openInvoice);
$('#cancelBtn').addEventListener('click', () => dlg.close());

$('#invoiceForm').addEventListener('submit', e => {
  e.preventDefault();
  const name = $('#fClient').value.trim();
  if (!name) return;

  // find or create the client
  let client = state.clients.find(
    c => c.name.toLowerCase() === name.toLowerCase());
  if (!client) {
    client = { id: uid(), name, email: '' };
    state.clients.push(client);
  }

  const paid = $('#fPaid').checked;
  state.invoices.push({
    id: uid(),
    clientId: client.id,
    desc: $('#fDesc').value.trim(),
    amount: parseFloat($('#fAmount').value) || 0,
    issueDate: $('#fIssue').value,
    dueDate: $('#fDue').value,
    paid,
    paidDate: paid ? todayISO() : null
  });

  dlg.close();
  renderAll();
});

/* ═══════════════════════════════════════════
   CLIENT FORM
   ═══════════════════════════════════════════ */
$('#clientForm').addEventListener('submit', e => {
  e.preventDefault();
  const name = $('#cName').value.trim();
  if (!name) return;
  state.clients.push({ id: uid(), name, email: $('#cEmail').value.trim() });
  $('#clientForm').reset();
  renderAll();
});

/* ═══════════════════════════════════════════
   GLOBAL CLICK HANDLERS
   ═══════════════════════════════════════════ */
document.addEventListener('click', e => {
  const pay = e.target.closest('[data-pay]');
  if (pay) {
    const inv = state.invoices.find(i => i.id === pay.dataset.pay);
    if (inv) {
      inv.paid = !inv.paid;
      inv.paidDate = inv.paid ? todayISO() : null;
      renderAll();
    }
    return;
  }

  const del = e.target.closest('[data-del]');
  if (del) {
    if (confirm('Delete this invoice?')) {
      state.invoices = state.invoices.filter(i => i.id !== del.dataset.del);
      renderAll();
    }
    return;
  }

  const delc = e.target.closest('[data-delclient]');
  if (delc) {
    const id = delc.dataset.delclient;
    if (confirm('Delete this client and all their invoices?')) {
      state.clients = state.clients.filter(c => c.id !== id);
      state.invoices = state.invoices.filter(i => i.clientId !== id);
      renderAll();
    }
    return;
  }

  const pr = e.target.closest('[data-print]');
  if (pr) { printInvoice(pr.dataset.print); return; }
});

/* ═══════════════════════════════════════════
