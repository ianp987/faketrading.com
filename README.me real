/* ═══════════════════════════════════════════
   FILTERS + TABS
   ═══════════════════════════════════════════ */
$('#filters').addEventListener('click', e => {
  const chip = e.target.closest('.chip');
  if (!chip) return;
  $$('#filters .chip').forEach(c => c.classList.remove('active'));
  chip.classList.add('active');
  currentFilter = chip.dataset.filter;
  renderInvoices();
});

$$('.tab').forEach(tab => {
  tab.addEventListener('click', () => {
    $$('.tab').forEach(t => t.classList.remove('active'));
    tab.classList.add('active');
    ['dashboard', 'invoices', 'clients', 'settings'].forEach(name => {
      $('#tab-' + name).hidden = name !== tab.dataset.tab;
    });
  });
});

/* ═══════════════════════════════════════════
   SETTINGS
   ═══════════════════════════════════════════ */
function loadSettingsIntoForm() {
  $('#sBizName').value = state.business.name || '';
  $('#sBizEmail').value = state.business.email || '';
  $('#sCurrency').value = state.currency;
}

$('#sBizName').addEventListener('input', e => {
  state.business.name = e.target.value; save();
});
$('#sBizEmail').addEventListener('input', e => {
  state.business.email = e.target.value; save();
});
$('#sCurrency').addEventListener('change', e => {
  state.currency = e.target.value;
  renderAll();
});

/* ═══════════════════════════════════════════
   EXPORT CSV
   ═══════════════════════════════════════════ */
$('#exportBtn').addEventListener('click', () => {
  if (!state.invoices.length) { alert('No invoices to export yet.'); return; }
  const rows = [['Client', 'Description', 'Amount', 'Currency', 'Issued', 'Due', 'Status', 'Paid date']];
  state.invoices.forEach(i => rows.push([
    clientName(i.clientId), i.desc, i.amount, state.currency,
    i.issueDate, i.dueDate, invoiceStatus(i), i.paidDate || ''
  ]));
  const csv = rows
    .map(r => r.map(v => `"${String(v ?? '').replace(/"/g, '""')}"`).join(','))
    .join('\r\n');

  const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `hustletrack-${todayISO()}.csv`;
  a.click();
  URL.revokeObjectURL(a.href);
});

